    "This archive is password-protected, which is not supported.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Archiv ist passwortgeschützt, was nicht unterstützt wird."
