    "…or a direct link to the image": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "…oder ein Direktlink zum Bild"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "…o un enlace directo a la imagen"
          }
        }
      }
    },
    "“%@” is not a valid key. Use letters, numbers and hyphens only.": {
      "comment": "Rejected metadata key. Placeholder is the entered key.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist kein gültiger Schlüssel. Nur Buchstaben, Zahlen und Bindestriche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no es una clave válida. Usa solo letras, números y guiones."
          }
        }
      }
    },
    "\\n is a line break, \\t is a tab. Leave empty for no separator at all.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\\n steht für einen Zeilenumbruch, \\t für einen Tabulator. Leer lassen bedeutet: kein Trennzeichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\\n es un salto de línea, \\t es un tabulador. Déjalo vacío para no usar separador."
          }
        }
      }
    },
    "%@ fps instead of %@ fps": {
      "comment": "fps stays as the unit abbreviation",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fps statt %@ fps"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fps en vez de %@ fps"
          }
        }
      }
    },
