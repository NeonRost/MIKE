    "An unedited original is already saved next to this file from an earlier run. It will be kept, and this change is written without a second backup.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neben dieser Datei liegt bereits ein unverändertes Original aus einem früheren Lauf. Es bleibt erhalten, und diese Änderung wird ohne zweite Sicherung geschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Junto a este archivo ya se guardó un original sin editar de una ejecución anterior. Se conservará y este cambio se escribe sin una segunda copia de seguridad."
          }
        }
      }
    },
