    "%lld characters cannot be represented in %@. Choose a different target encoding, or remove them from the source.": {
      "comment": "First placeholder is a count, second is an encoding name",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Zeichen kann in %@ nicht dargestellt werden. Wähle ein anderes Ziel-Encoding oder entferne es aus der Quelle."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Zeichen können in %@ nicht dargestellt werden. Wähle ein anderes Ziel-Encoding oder entferne sie aus der Quelle."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld character cannot be represented in %@. Choose a different target encoding, or remove it from the source."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld characters cannot be represented in %@. Choose a different target encoding, or remove them from the source."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld carácter no se puede representar en %@. Elige otra codificación de destino o elimínalo de la fuente."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld caracteres no se pueden representar en %@. Elige otra codificación de destino o elimínalos de la fuente."
                }
              }
            }
          }
        }
      }
    },
