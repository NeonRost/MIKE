    "Finds identical files across one or more folders by size and then by content, so nothing is judged a duplicate by name alone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet identische Dateien in einem oder mehreren Ordnern – zuerst über die Größe, dann über den Inhalt, damit nichts allein anhand des Namens als Duplikat gilt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra archivos idénticos en una o varias carpetas, primero por tamaño y luego por contenido, de modo que nada se considera un duplicado solo por el nombre."
          }
        }
      }
    },
